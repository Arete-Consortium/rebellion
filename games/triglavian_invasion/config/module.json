  "missions": [
    {
      "id": "ti_m1_first_contact",
      "name": "FIRST CONTACT",
      "description": "Triglavian scouts have been spotted in Niarja. Intercept and eliminate.",
      "primaryObjective": "Destroy all Triglavian scouts",
      "bonusObjective": "Take no hull damage",
      "waves": 3,
      "isTutorial": true,
      "boss": "RaznaborgVedmak"
    },
    {
      "id": "ti_m2_stellar_transmuter",
      "name": "STELLAR TRANSMUTER",
      "description": "Prevent the Triglavians from deploying their stellar harvester in Raravoss.",
      "primaryObjective": "Destroy the harvester escort",
      "bonusObjective": "Destroy all harvester drones",
      "waves": 4,
      "boss": "PerunDrekavac"
    },
    {
      "id": "ti_m3_liminality_rising",
      "name": "LIMINALITY RISING",
      "description": "The system of Sakenta is approaching Final Liminality. Hold the line.",
      "primaryObjective": "Survive until reinforcements arrive",
      "bonusObjective": "Destroy elite Triglavian squadron",
      "waves": 4,
      "boss": "VelesLeshak"
    },
    {
      "id": "ti_m4_pochvens_edge",
      "name": "POCHVEN'S EDGE",
      "description": "Systems are falling to Pochven. Vale must not be lost.",
      "primaryObjective": "Repel the invasion force",
      "bonusObjective": "Protect civilian stations",
      "waves": 5,
      "boss": "SvarogIkitursa"
    },
    {
      "id": "ti_m5_proving_ground",
      "name": "PROVING GROUND",
      "description": "The Collective seeks to prove their might in Kuharah. Show them ours.",
      "primaryObjective": "Defeat the Proving force",
      "bonusObjective": "Perfect victory",
      "waves": 5,
      "boss": "ProvingDrekavac"
    },
    {
      "id": "ti_m6_gate_defense",
      "name": "GATE DEFENSE",
      "description": "Defend the Otela stargate from a full-scale Triglavian assault.",
      "primaryObjective": "Hold the gate",
      "bonusObjective": "Destroy the siege platforms",
      "waves": 6,
      "boss": "SiegeLeshak"
    },
    {
      "id": "ti_m7_world_ark_assault",
      "name": "WORLD ARK ASSAULT",
      "description": "A Triglavian World Ark has been detected in Kino. This is our chance.",
      "primaryObjective": "Breach the World Ark defenses",
      "bonusObjective": "Destroy all escort squadrons",
      "waves": 6,
      "boss": "XordazhWorldArk"
    },
    {
      "id": "ti_m8_zoryas_domain",
      "name": "ZORYA'S DOMAIN",
      "description": "Push into Pochven and strike at the heart of the invasion.",
      "primaryObjective": "Survive the gauntlet",
      "bonusObjective": "Destroy Zorya's Champion",
      "waves": 7,
      "boss": "ZoryasChampion"
    },
    {
      "id": "ti_m9_final_proving",
      "name": "THE FINAL PROVING",
      "description": "End the invasion at the Triglavian Stronghold. Victory or death.",
      "primaryObjective": "Defeat Zorya Triglav",
      "bonusObjective": "Flawless victory",
      "waves": 8,
      "boss": "ZoryaTriglav"
    }
  ],

