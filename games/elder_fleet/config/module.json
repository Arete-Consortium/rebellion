  "author": "EVE Rebellion Team",

  "factions": [
    {
      "id": "minmatar",
      "name": "Minmatar Republic",
      "emblem": "minmatar_emblem.png",
      "primaryColor": "#b56433",
      "secondaryColor": "#8c592b",
      "accentColor": "#ff9633",
      "doctrine": ["Projectiles", "Speed", "Guerrilla"],
      "description": "In Rust We Trust. Your ancestors were enslaved. Today, you strike back."
    },
    {
      "id": "amarr",
      "name": "Amarr Empire",
      "emblem": "amarr_emblem.png",
      "primaryColor": "#ffd500",
      "secondaryColor": "#cc9933",
      "accentColor": "#fff299",
      "doctrine": ["Lasers", "Armor", "Divine Right"],
      "description": "Crush the rebel insurrection. Restore order through strength."
    }
  ],

