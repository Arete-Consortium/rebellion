      "bonusObjective": "No friendly losses",
      "waves": 4,
      "boss": "WingCommander"
    },
    {
      "id": "ef_m4_sacred_relic",
      "name": "SACRED RELIC",
      "description": "An Amarr cathedral-ship carries artifacts of oppression. Destroy it.",
