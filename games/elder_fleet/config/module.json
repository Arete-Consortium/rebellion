  "missions": [
    {
      "id": "ef_m1_first_blood",
      "name": "FIRST BLOOD",
      "description": "The rebellion begins. Strike the first blow against Amarr patrols.",
      "primaryObjective": "Destroy enemy patrol ships",
      "bonusObjective": "Take no damage",
      "waves": 3,
      "isTutorial": true,
      "boss": null
    },
    {
      "id": "ef_m2_supply_raid",
      "name": "SUPPLY RAID",
      "description": "Amarr supply convoys are undefended. Seize what you need.",
      "primaryObjective": "Destroy the convoy",
      "bonusObjective": "Destroy all escorts first",
      "waves": 4,
      "boss": "SquadronLeader"
    },
    {
      "id": "ef_m3_freedom_fighters",
      "name": "FREEDOM FIGHTERS",
      "description": "Minmatar slaves are staging an uprising. Protect them from reprisal.",
