      "bonusObjective": "Destroy all defense turrets",
      "waves": 5,
      "unlocks": ["assault_frigate"],
      "boss": "FleetCommander"
    },
    {
      "id": "ef_m5_empires_end",
      "name": "EMPIRE'S END",
